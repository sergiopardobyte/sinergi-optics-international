
<?xml version="1.0" encoding="UTF-8"?>

<!-- Configuración principal del proyecto Maven -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- Versión del modelo de configuración Maven -->
    <modelVersion>4.0.0</modelVersion>

    <!-- Configuración heredada de Spring Boot -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.3</version>
        <relativePath/>
    </parent>

    <!-- Identificación de nuestro proyecto -->
    <groupId>com.sinergi</groupId>
    <artifactId>sinergi-optics</artifactId>
    <version>1.0.0</version>

    <!-- Nombre y descripción del proyecto -->
    <name>Sinergi Optics International</name>
    <description>Sistema web para una óptica</description>

    <!-- Versión de Java que utilizaremos -->
    <properties>
        <java.version>17</java.version>
    </properties>

    <!-- Dependencias o herramientas que necesita el proyecto -->
    <dependencies>

        <!-- Permite crear aplicaciones y páginas web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Permite trabajar con entidades y bases de datos -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Base de datos H2 para guardar información -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        
        <!-- Seguridad para controlar usuarios y administradores -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>


    </dependencies>

    <!-- Configuración para ejecutar la aplicación -->
    <build>
        <plugins>

            <!-- Plugin que permite iniciar Spring Boot -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

        </plugins>
    </build>

</project>
